# Shared secret. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
RELAY_TOKEN=change-me

# Browser origin(s) the Even Hub WebView serves your plugin from, comma-separated.
# Use "*" only for local testing.
RELAY_ALLOWED_ORIGINS=*

# How many recent notifications to keep for /poll and late-joining clients.
RELAY_RING_SIZE=50
